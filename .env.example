# Database Connection
# Get your Neon PostgreSQL connection string from https://neon.tech
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Encryption Key for API Keys
# CRITICAL: Generate a unique 32-byte hex string for production
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Never commit the actual key to version control
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# Claude AI API Key (Optional)
# Server-side API key used when users don't provide their own
# Get from: https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=sk-ant-your-api-key-here

# Claude AI Configuration (Optional)
PUBLIC_CLAUDE_MODEL=claude-3-haiku-20240307
PUBLIC_CLAUDE_MAX_TOKENS=4096

# Email Service (Resend)
# Get your API key from: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# App URL (for magic link emails)
PUBLIC_APP_URL=http://localhost:4321
