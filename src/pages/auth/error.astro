---
import Layout from '../../layouts/Layout.astro';

const reason = Astro.url.searchParams.get('reason') || 'unknown';

const errorMessages: Record<string, { title: string; description: string }> = {
  missing_token: {
    title: 'Missing Token',
    description: 'No authentication token was provided. Please check your email and click the link again.',
  },
  invalid_token: {
    title: 'Invalid or Expired Link',
    description: 'This link is invalid or has expired. Please request a new login link.',
  },
  user_not_found: {
    title: 'Account Not Found',
    description: 'No account was found for this email. You may need an invitation to create an account.',
  },
  server_error: {
    title: 'Server Error',
    description: 'An unexpected error occurred. Please try again later.',
  },
  unknown: {
    title: 'Something Went Wrong',
    description: 'An error occurred during authentication. Please try again.',
  },
};

const error = errorMessages[reason] || errorMessages.unknown;
---

<Layout title="Authentication Error - Finance Graphs">
  <div class="min-h-screen bg-white flex items-center justify-center p-4">
    <div class="max-w-md w-full text-center">
      <!-- Error Icon -->
      <div class="mx-auto w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mb-6">
        <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>

      <!-- Error Message -->
      <h1 class="text-2xl font-bold text-gray-900 mb-2">{error.title}</h1>
      <p class="text-gray-600 mb-8">{error.description}</p>

      <!-- Actions -->
      <div class="space-y-3">
        <a
          href="/"
          class="block w-full py-3 px-4 bg-indigo-600 text-white rounded-full font-medium hover:bg-indigo-700 transition-colors"
        >
          Go to Login
        </a>
        <a
          href="mailto:support@example.com"
          class="block text-indigo-600 hover:text-indigo-700 font-medium text-sm"
        >
          Need help? Contact support
        </a>
      </div>
    </div>
  </div>
</Layout>
